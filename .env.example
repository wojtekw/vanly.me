DATABASE_URL=postgres://vanly_app:CHANGE_ME@127.0.0.1:5432/vanly_local
TEST_DATABASE_URL=postgres://vanly_app:CHANGE_ME@127.0.0.1:5432/vanly_test
APP_ORIGIN=https://vanly.me.local
# Optional additional exact origins, comma-separated; no wildcards.
APP_ADDITIONAL_ORIGINS=https://vanly.local,https://camperfolks.com.local,https://heyvans.com.local
API_PORT=4100
LOCAL_PAYMENTS=true
# Travelers reserve for free and settle rent/deposit directly with the rental company.
TRAVELER_PAYMENT_MODE=direct
NODE_ENV=production
# Canonical URL for the public portal; local builds remain blocked from indexing until explicitly enabled.
SEO_SITE_URL=https://vanly.me
SEO_INDEXING_ENABLED=false
# Anonymous server-side catalog/article reads. Never point this at a private endpoint.
SEO_API_INTERNAL_URL=http://127.0.0.1:4100/api/v1
# Google Maps: activate only after API/referrer restrictions and Cloud quotas are verified.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_QUOTAS_CONFIRMED=false
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_DAILY_LOADS=100
GOOGLE_MAPS_MONTHLY_LOADS=2000
GOOGLE_PLACES_DAILY_QUERIES=200
GOOGLE_PLACES_MONTHLY_QUERIES=6000

# Transactional mail: local is the safe default and only writes the local inbox.
MAIL_PROVIDER=local
# Explicit deployment scope; runtime NODE_ENV=production can still be a local build.
MAIL_DEPLOYMENT_ENVIRONMENT=local
# Local test routing is opt-in: all recipients use this one mailbox and VANLY-TEST: subjects.
# Enabling it never changes MAIL_PROVIDER or enables SES. Keep recipient blank while disabled.
MAIL_TEST_MODE=false
MAIL_TEST_RECIPIENT=
# To deliberately send local tests through SES, use configure-mailer-local.mjs
# with --test-recipient ADDRESS --test-ses-profile PROFILE after AWS access is ready.
# This requires local test routing and sets a fresh SES cutover; production is rejected.
# SES requires BOTH values below plus valid public HTTPS APP_URL and sender data.
MAIL_SES_ENABLED=false
# Required for SES: ISO timestamp of a deliberate cutover, excluding historical jobs.
MAIL_SES_START_AFTER=
APP_URL=https://vanly.me.local
MAIL_AWS_REGION=eu-central-1
# Plain mailbox addresses, without a display name. Required for SES.
MAIL_FROM=portal@vanly.me
MAIL_FROM_NO_REPLY=no-reply@vanly.me
MAIL_FROM_PORTAL=portal@vanly.me
MAIL_REPLY_TO=info@wydmuch.xyz
MAIL_SENDER_LEGAL_NAME=
MAIL_SENDER_LEGAL_ADDRESS=
MAIL_SENDER_REGISTRATION_DETAILS=
# Optional SES configuration set for delivery/bounce/complaint publishing.
MAIL_SES_CONFIGURATION_SET=
# Optional authenticated feedback transport SES -> SNS -> SQS. Off by default.
# Required together when enabled; same AWS region/account, standard queues/topics.
MAIL_FEEDBACK_ENABLED=false
MAIL_FEEDBACK_QUEUE_URL=
MAIL_FEEDBACK_SNS_TOPIC_ARN=
MAIL_FEEDBACK_BATCH_SIZE=10
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_SECONDS=30
MAIL_SEND_TIMEOUT_MS=10000
MAIL_LEASE_SECONDS=120
MAIL_BATCH_SIZE=10
MAIL_POLL_MS=5000
MAIL_PAYLOAD_RETENTION_HOURS=24
# Credentials are NOT set here. Use an AWS role or the SDK default credential chain.

# Automated reminders require a deliberate ISO cutover with Z or explicit offset.
MAIL_REMINDERS_ENABLED=false
NOTIFICATION_START_AFTER=
MAIL_REMINDERS_SEND_HOUR=9
MAIL_UNREAD_DELAY_MINUTES=5
MAIL_UNREAD_COOLDOWN_HOURS=12
MAIL_REMINDERS_BATCH_SIZE=100
# Confirmed double opt-in and administrator-approved campaigns only.
MAIL_NEWSLETTER_ENABLED=false
