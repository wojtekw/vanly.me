user www-data;
worker_processes auto;
pid /run/nginx.pid;
events { worker_connections 1024; }
http {
    map_hash_bucket_size 128;
    include /etc/nginx/mime.types;
    server_tokens off;
    # No Authorization, cookies, query strings or account data in proxy logs.
    log_format uat '$remote_addr $request_method $uri $status';
    access_log /var/log/nginx/access.log uat;
    error_log /var/log/nginx/error.log warn;
    # CloudFront overwrites this header with the original viewer host. The origin
    # Host stays origin.uat.vanly.me, matching its separate TLS certificate.
    map $http_x_vanly_viewer_host $uat_backend {
        default '';
        uat.vanly.me http://127.0.0.1:3100;
        owner.uat.vanly.me http://127.0.0.1:8182;
        admin.uat.vanly.me http://127.0.0.1:8183;
    }
    map $http_x_vanly_origin $uat_origin_ok {
        default 0;
        "__ORIGIN_SECRET__" 1;
    }
    server {
        listen 80 default_server;
        server_name _;
        location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
        location / { return 308 https://$host$request_uri; }
    }
    server {
        listen 443 ssl default_server;
        server_name origin.uat.vanly.me;
        ssl_certificate __TLS_CERT__;
        ssl_certificate_key __TLS_KEY__;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($uat_backend = '') { return 403; }
        if ($uat_origin_ok = 0) { return 403; }
        auth_basic "VANLY UAT";
        auth_basic_user_file __HTPASSWD__;
        client_max_body_size 12m;
        proxy_http_version 1.1;
        proxy_set_header Host $http_x_vanly_viewer_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Vanly-Protocol https;
        # Do not trust viewer-supplied IP chains or send the gateway password to apps.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header X-Vanly-Origin "";
        proxy_set_header X-Vanly-Viewer-Host "";
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Robots-Tag;
        add_header Cache-Control "private, no-store" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        location /api/ { proxy_pass http://127.0.0.1:4100; }
        location / { proxy_pass $uat_backend; }
    }
}
